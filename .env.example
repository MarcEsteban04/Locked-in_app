# Copy this file to .env.local and fill in the values, then restart the bundler
# with `npx expo start --clear` — Expo inlines these at build time, so a running
# bundler will not pick up edits.
#
# Only EXPO_PUBLIC_* variables reach the app, and they ship in the bundle as
# plain text. That is fine for the two below — Supabase protects data with row
# level security, not with key secrecy. It is NOT fine for a service-role key or
# an OpenAI key; those belong in EAS Secrets and are read server-side from an
# Edge Function.
#
# Both values are in your Supabase dashboard under Project Settings -> API.

EXPO_PUBLIC_SUPABASE_URL=
# Called the "publishable key" on newer projects and the "anon key" on older
# ones — same value, same slot.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
